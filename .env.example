# ------------------------------------------------------------------
# Base de données — OBLIGATOIRE
# ------------------------------------------------------------------
# Tout le contenu du site vit en base : animaux, livre d'or, actualités,
# comptes… Rien n'est stocké dans des fichiers.
#
# En local  : postgres://utilisateur@localhost:5432/asad
# En ligne  : la chaîne fournie par Neon, Supabase ou Vercel Postgres.
DATABASE_URL=postgres://utilisateur@localhost:5432/asad

# ------------------------------------------------------------------
# Configuration ASAD — copier ce fichier en `.env.local` et compléter.
# Toutes ces variables sont optionnelles : sans elles, les valeurs par
# défaut de `src/content/site.ts` s'appliquent.
# ------------------------------------------------------------------

# URL canonique du site (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://asad.fr

# Liens HelloAsso — le paiement est géré par HelloAsso, rien à développer.
NEXT_PUBLIC_HELLOASSO_DON=https://www.helloasso.com/associations/asad/formulaires/don
NEXT_PUBLIC_HELLOASSO_URGENCE=https://www.helloasso.com/associations/asad/formulaires/urgence-veterinaire
NEXT_PUBLIC_HELLOASSO_ADHESION=https://www.helloasso.com/associations/asad/adhesions/adhesion
NEXT_PUBLIC_HELLOASSO_PAGE=https://www.helloasso.com/associations/asad

# Réseaux sociaux
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/asad
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/asad

# Destinataire des formulaires (adoption, famille d'accueil, bénévolat…).
# Sans configuration, les demandes sont journalisées côté serveur.
ASAD_CONTACT_EMAIL=contact@asad.fr

# Optionnel : webhook (Make, Zapier, n8n…) qui reçoit les demandes en JSON.
ASAD_FORM_WEBHOOK_URL=

# Optionnel : URL du widget HelloAsso à intégrer en iframe sur la page de don.
# Vide = seuls les boutons sont affichés.
NEXT_PUBLIC_HELLOASSO_IFRAME=

# ------------------------------------------------------------------
# Authentification du back-office
# ------------------------------------------------------------------

# Clé de signature des sessions — 32 caractères minimum.
# Générez-la avec « npm run auth:secret », puis reportez-la ici en production.
# Sans elle, la connexion est refusée en production.
ASAD_AUTH_SECRET=

# Les comptes du back-office sont stockés en base de données.
# Créez-les avec « npm run auth:demarrage ».

# ------------------------------------------------------------------
# Assistant de rédaction des fiches animaux (facultatif)
# ------------------------------------------------------------------
# Sans clé, l'assistant n'apparaît pas dans le back-office et les fiches
# se remplissent normalement à la main.
# Clé à créer sur https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modèle utilisé. Par défaut : gpt-5.6-terra.
# gpt-5.6-luna est moins cher, gpt-5.6-sol écrit un peu mieux.
OPENAI_MODEL=
